{
  "manifest_version": 3,
  "name": "LightTabs",
  "short_name": "LightTabs",
  "version": "1.2.0",
  "description": "Free memory by suspending idle tabs, and save tab lists for later. Suspended tabs stay safe even if the extension is removed.",
  "minimum_chrome_version": "121",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "LightTabs",
    "default_popup": "ui/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "ui/options/options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "alarms",
    "favicon",
    "contextMenus",
    "tabGroups",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Open LightTabs"
    },
    "suspend-tab": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Suspend the current tab"
    },
    "suspend-others": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Suspend other tabs in this window"
    },
    "save-window": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Save this window's tabs and close them"
    },
    "open-overview": {
      "description": "Show an overview of all tabs"
    },
    "open-saved": {
      "description": "Open the saved tabs page"
    }
  }
}
