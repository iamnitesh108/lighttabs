{
  "name": "lighttabs",
  "private": true,
  "version": "1.0.0",
  "description": "Free memory by suspending idle tabs, and save tab lists for later.",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings src tests scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && vite build",
    "package": "npm run check && node scripts/package.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^24.19.0",
    "jsdom": "^30.1.1",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
